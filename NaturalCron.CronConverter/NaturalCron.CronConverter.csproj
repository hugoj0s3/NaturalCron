<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>NaturalCron.CronConverter</PackageId>
        <Version>1.0.0</Version>
        <Authors>Hugo Silva</Authors>
        <Company>Hugo Silva</Company>
        <Description>Converts NaturalCron natural language expressions to classic cron strings. Supports Unix cron, Cronos, Quartz.NET, and NCrontab via built-in presets.</Description>
        <PackageProjectUrl>https://github.com/hugoj0s3/NaturalCron</PackageProjectUrl>
        <RepositoryUrl>https://github.com/hugoj0s3/NaturalCron</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright 2025 Hugo Silva</Copyright>
        <PackageTags>cron;naturalcron;cron-converter;schedule;scheduling;quartz;cronos;ncrontab;dotnet;csharp</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>NaturalCron.CronConverter.NuGet.README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="NaturalCron.CronConverter.NuGet.README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NaturalCron" Version="1.0.1" />
    </ItemGroup>

</Project>
