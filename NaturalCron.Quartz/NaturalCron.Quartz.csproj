<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <PackageId>NaturalCron.Quartz</PackageId>
        <Version>0.0.1-alpha</Version>
        <Authors>Hugo Silva</Authors>
        <Company>Hugo Silva</Company>
        <Description>Quartz.NET trigger extension for natural language scheduling. Schedule jobs with phrases like "every Monday at 9am" or "every 5 seconds".</Description>
        <PackageTags>Quartz;cron;scheduler;natural language;dotnet</PackageTags>
        <PackageProjectUrl>https://github.com/hugoj0s3/NaturalCron</PackageProjectUrl>
        <RepositoryUrl>https://github.com/hugoj0s3/NaturalCron</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright 2025 Hugo Silva</Copyright>
        <PackageReleaseNotes>
Alpha release. API and features may change. See https://github.com/hugoj0s3/NaturalCron for documentation and usage.
</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ReadMe>../docs/quartz/README.md</ReadMe>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="NaturalCron" Version="0.2.0" />
      <PackageReference Include="Quartz" Version="3.14.0" />
    </ItemGroup>

</Project>
